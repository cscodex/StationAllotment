# Local Development Environment Variables
# Copy this file to .env for local development
# DO NOT commit .env file to version control

# Environment Mode
NODE_ENV=development

# Server Port
PORT=5000

# Database Connection String
# For local testing, you can use:
# 1. A local PostgreSQL database
# 2. A separate Neon database for development
# Replace with your actual connection string
DATABASE_URL=postgresql://username:password@localhost:5432/station_allotment

# Session Secret (for encrypting session data)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your-local-dev-session-secret-here

# Optional: Set timezone (defaults to system timezone)
# TZ=Asia/Kolkata
