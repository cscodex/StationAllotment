# Render Environment Variables
# Copy these variables to Render Dashboard → Environment → Add Environment Variable
# Replace placeholder values with your actual credentials

# Environment Mode
NODE_ENV=production

# Server Port (Render uses 10000 by default)
PORT=10000

# Neon PostgreSQL Database Connection String
# Format: postgresql://[username]:[password]@[ep-xxxxx-xxxxx.region.aws.neon.tech]/[database]?sslmode=require
# Get this from: https://console.neon.tech/ → Your Project → Connection Details
# Example: postgresql://neondb_owner:AbCdEf123456@ep-cool-darkness-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://[username]:[password]@[ep-xxxxx-xxxxx.region.aws.neon.tech]/[database]?sslmode=require

# Session Secret (for encrypting session data)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# This should be a random 64-character hexadecimal string
SESSION_SECRET=[generate-a-random-64-character-hex-string]

# NPM Configuration (ensures devDependencies are installed during build)
# This is required because vite, esbuild, and other build tools are in devDependencies
# Note: If using render.yaml, this is already set. Only add manually if not using render.yaml
NPM_CONFIG_PRODUCTION=false

